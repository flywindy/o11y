        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Value"}, "properties": [
            {"id": "unit", "value": "reqps"},
            {"id": "custom.cellOptions", "value": {"mode": "gradient", "type": "gauge"}}
          ]}
