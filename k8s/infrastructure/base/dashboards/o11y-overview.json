        "description": "Single-select. Source: target_info, which the OTel SDK Prometheus exporter and the Collector's prometheusremotewrite exporter both emit unconditionally regardless of WithRuntimeMetrics. The job label has the form <service.namespace>/<service.name>; the regex below extracts the namespace.",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(target_info, job)",
        "query": {"query": "label_values(target_info, job)", "refId": "service_namespace"},
        "refresh": 2,
        "regex": "/^(?<value>[^/]+)\\/[^/]+$/",
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
