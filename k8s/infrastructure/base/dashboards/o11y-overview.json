  "panels": [
    {
      "type": "stat",
      "title": "Service Up",
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "DOWN", "color": "red"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]},
          "color": {"mode": "thresholds"},
          "unit": "none"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "max(target_info{job=~\"$service_namespace/$service_name\",deployment_environment_name=~\"$environment\",service_version=~\"$service_version\"})",
          "legendFormat": "up",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Request rate",
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "blue", "value": null}
          ]},
          "color": {"mode": "thresholds"},
          "unit": "reqps"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_namespace=~\"$service_namespace\",service_name=~\"$service_name\",deployment_environment_name=~\"$environment\",service_version=~\"$service_version\",http_route=~\"$http_route\"}[$__rate_interval]))",
          "legendFormat": "rps",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 5}
          ]},
          "color": {"mode": "thresholds"},
          "unit": "percent",
          "decimals": 2
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{service_namespace=~\"$service_namespace\",service_name=~\"$service_name\",deployment_environment_name=~\"$environment\",service_version=~\"$service_version\",http_route=~\"$http_route\",http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_namespace=~\"$service_namespace\",service_name=~\"$service_name\",deployment_environment_name=~\"$environment\",service_version=~\"$service_version\",http_route=~\"$http_route\"}[$__rate_interval])), 0.0001)",
          "legendFormat": "err %",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "P95 latency",
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 0.25},
            {"color": "red", "value": 1}
          ]},
          "color": {"mode": "thresholds"},
          "unit": "s"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_namespace=~\"$service_namespace\",service_name=~\"$service_name\",deployment_environment_name=~\"$environment\",service_version=~\"$service_version\",http_route=~\"$http_route\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Goroutines",
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "blue", "value": null},
            {"color": "yellow", "value": 1000},
            {"color": "red", "value": 10000}
